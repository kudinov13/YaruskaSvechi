# Backend env — copy to server/.env and fill real values.
# Production values live on the server: /opt/yaruska-api/.env
# Pull them: scp yaruska:/opt/yaruska-api/.env server/.env

DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/yaruska
JWT_SECRET=
PORT=4000

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# CDEK
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
CDEK_SHIPMENT_POINT=BTV7
CDEK_SENDER_CITY_CODE=467
CDEK_SENDER_NAME=
CDEK_SENDER_EMAIL=
CDEK_SENDER_PHONE=
