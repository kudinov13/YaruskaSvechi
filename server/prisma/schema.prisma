generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  NEW
  PAID
  ASSEMBLED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id                           String   @id @default(cuid())
  email                        String   @unique
  name                         String
  password                     String
  phone                        String?
  role                         Role     @default(USER)
  dataProcessingConsentAt      DateTime?
  dataProcessingConsentVersion String?
  orders                       Order[]
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model Category {
  id    String    @id @default(cuid())
  slug  String    @unique
  title String
  order Int       @default(0)
  items Candle[]
}

model Candle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  notes       String?
  price       Int
  oldPrice    Int?
  stock       Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  variants           Json?
  shippingWeightGrams Int?
  shippingPackagePreset String?
  featured            Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id                           String      @id @default(cuid())
  userId                       String
  user                         User        @relation(fields: [userId], references: [id])
  items                        OrderItem[]
  total                        Int
  goodsTotal                   Int?
  deliveryPrice                Int             @default(0)
  status                       OrderStatus     @default(NEW)
  paymentStatus                String          @default("PENDING")
  paymentId                    String?         @unique
  paymentConfirmationUrl       String?
  deliveryTariffCode           Int?
  deliveryCityCode             Int?
  deliveryCity                 String?
  deliveryPointCode            String?
  deliveryPointAddress         String?
  recipientName                String?
  recipientPhone               String?
  recipientEmail               String?
  cdekOrderUuid                String?         @unique
  cdekTrack                    String?
  cdekStatusCode               String?
  cdekStatus                   String?
  cdekStatusUpdatedAt          DateTime?
  address                      String?
  offerAcceptedAt              DateTime?
  offerVersion                 String?
  dataProcessingConsentAt      DateTime?
  dataProcessingConsentVersion String?
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  candleId  String?
  candle    Candle? @relation(fields: [candleId], references: [id], onDelete: SetNull)
  title     String
  price     Int
  quantity  Int
}
