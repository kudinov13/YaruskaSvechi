#!/bin/bash
set -e
GIT_DIR=/srv/git/yaruska.git
WORK=/opt/yaruska-build
WEB=/var/www/yaruska
API=/opt/yaruska-api

echo "==> Deploy started"
git --work-tree=$WORK --git-dir=$GIT_DIR checkout -f main

echo "==> Frontend: installing dependencies"
cd $WORK
npm ci --no-audit --no-fund

echo "==> Frontend: building"
VITE_API_URL=/api npm run build
rsync -a --delete $WORK/dist/ $WEB/

echo "==> Backend: syncing code"
mkdir -p $API/uploads
rsync -a --delete --exclude node_modules --exclude uploads --exclude .env $WORK/server/ $API/
cd $API
npm ci --omit=dev --no-audit --no-fund

echo "==> Backend: prisma"
npx prisma generate
npx prisma db push

echo "==> Backend: restart"
systemctl restart yaruska-api || systemctl start yaruska-api
echo "==> Deploy finished"
